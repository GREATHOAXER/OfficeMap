# 복사해서 server/.env 로 쓰세요
DATABASE_URL=postgresql://officemap:officemap@localhost:5432/officemap

# 로그인 쿠키
SESSION_COOKIE_NAME=officemap_session
SESSION_MAX_HOURS=12
# HTTPS로 서비스할 때 true (로컬 http에서는 false)
COOKIE_SECURE=false

# 실제 데이터가 든 서버는 production: DB를 통째로 지우는 init_db --reset을 막는다
APP_ENV=development
