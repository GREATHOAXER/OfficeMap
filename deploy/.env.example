# 복사해서 deploy/.env 로 쓰세요: cp .env.example .env
# .env에는 DB 비밀번호가 들어가므로 git에 올리지 않습니다 (.gitignore)

# DB 접속 주소: RDS 엔드포인트와 마스터 계정 비밀번호.
# 비밀번호는 영문·숫자로만 정하세요 (# ? % : 같은 기호는 주소 안에서 다른 뜻이 되어 접속이 깨집니다)
DATABASE_URL=postgresql://officemap:비밀번호@officemap-db.xxxxxxxxxxxx.ap-northeast-2.rds.amazonaws.com:5432/officemap?sslmode=require
# 내 PC에서 RDS 없이 시험할 때 (docker compose --profile local-db up -d --build):
# DATABASE_URL=postgresql://officemap:officemap@db:5432/officemap

# 접속 주소. ":80"이면 HTTP로 서버 IP에 접속. 도메인을 연결했으면 도메인 이름을 넣으면 HTTPS가 저절로 켜집니다
SITE_ADDRESS=:80
# HTTPS로 접속할 때만 true (HTTP에서 true면 로그인 쿠키가 저장되지 않아 로그인이 안 됨)
COOKIE_SECURE=false

# 실제 데이터를 넣은 뒤에는 production으로: DB를 통째로 지우는 init_db --reset이 막힙니다
APP_ENV=staging

# API 서버 프로세스 수
WEB_CONCURRENCY=2

# AI 도우미 (docs/ai.md). 비우면 꺼진다 (화면에는 "준비 중"으로 보임)
#   anthropic: Anthropic API. 아래 ANTHROPIC_API_KEY 필요
#   bedrock:   Amazon Bedrock. 키 없이 EC2의 IAM 역할로 (bedrock-mantle:CreateInference 권한)
AI_PROVIDER=
# ANTHROPIC_API_KEY=
# 모델을 바꿀 때만 (기본: anthropic은 claude-opus-5-5, bedrock은 anthropic.claude-opus-5-5)
# AI_MODEL=
# 답을 얼마나 꼼꼼히 생각할지: low(빠르고 쌈) · medium · high
# AI_EFFORT=medium

# GitHub Actions 자동 배포(docs/cicd.md)를 쓸 때만: 이미지를 받아 올 ECR 주소 (끝에 /). 비우면 서버에서 빌드한 이미지를 쓴다
# IMAGE_PREFIX=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/
# 지금 떠 있는 버전 (배포 스크립트 deploy/remote-deploy.sh가 적는다. 손으로 고치지 않음)
# IMAGE_TAG=
