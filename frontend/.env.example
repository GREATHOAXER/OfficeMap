# 복사해서 frontend/.env.local 로 쓰세요
# FastAPI 서버 주소 (uvicorn)
API_URL=http://localhost:8000
# 사내 통합인증(SSO) 연동 전까지 false: SSO 버튼은 '준비 중'으로 표시
SSO_ENABLED=false
# 개발 서버(npm run dev)를 localhost가 아닌 주소로 열 때 그 호스트 이름. 쉼표로 여러 개 (주소째 넣어도 호스트만 씀)
# ngrok은 개발 서버보다 먼저 켜 두면 자동으로 허용되니 비워 둬도 됨. 빌드해서 띄우는 npm start에는 필요 없음
# (빈 값으로 두면 .env에 적은 값을 가리니, 쓸 때만 앞의 #을 지우고 값을 넣는다)
# DEV_ORIGINS=abcd-12-34-56.ngrok-free.dev
