# 복사해서 frontend/.env.local 로 쓰세요
# FastAPI 서버 주소 (uvicorn)
API_URL=http://localhost:8000
# 사내 통합인증(SSO) 연동 전까지 false: SSO 버튼은 '준비 중'으로 표시
SSO_ENABLED=false
# 개발 서버(npm run dev)를 localhost가 아닌 주소(ngrok 등)로 열 때 그 호스트 이름. 쉼표로 여러 개, https://·포트 없이
# 예: DEV_ORIGINS=abcd-12-34-56.ngrok-free.app   (빌드해서 띄우는 npm start에는 필요 없음)
DEV_ORIGINS=
